# alpaca_btc — environment template
# Copy to `.env` and fill in your own values. Never commit `.env` itself.

# Alpaca paper-trading credentials (https://alpaca.markets)
ALPACA_PAPER_API_KEY=PK...
ALPACA_PAPER_SECRET_KEY=...
USE_PAPER_TRADING=True

# Optional: live keys (only used when USE_PAPER_TRADING=False)
# ALPACA_LIVE_API_KEY=
# ALPACA_LIVE_SECRET_KEY=

# Required for the end-of-day analyzer (analyzers/eod_summary.py)
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
